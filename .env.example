# Replace the placeholders on the Linux host.
DATABASE_URL=postgresql://tonghop:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/tonghop
SOLUTIONS_ROOT=/opt/tong-hop-giai-phap/Solutions
UPLOADS_ROOT=/opt/tong-hop-giai-phap/storage/uploads
HOST=127.0.0.1
PORT=8787
NODE_ENV=production
# First setup only. Remove after npm run db:setup succeeds.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=true
CORS_ORIGIN=https://kaliot.online
# Only for loopback API reached through local cloudflared.
TRUST_CLOUDFLARE=true
# Optional persistent signing key for login CAPTCHA challenges.
CAPTCHA_SECRET=replace-with-a-long-random-value
# Public frontend setting: set in Cloudflare BUILD environment and rebuild.
VITE_API_BASE=https://api.kaliot.online
